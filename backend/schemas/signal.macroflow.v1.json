{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Macro/Flow v1",
  "type": "object",
  "required": [
    "contractVersion",
    "classeAtivo",
    "instrumento",
    "timestamp",
    "sinal"
  ],
  "properties": {
    "contractVersion": { "const": "signal.macroflow.v1" },
    "classeAtivo": { "type": "string", "enum": ["forex", "cripto", "acoes", "indices", "commodities"] },
    "instrumento": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "par": { "type": "string" },
        "tickerYahoo": { "type": "string" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "sinal": {
      "type": "object",
      "required": ["viesSessao"],
      "properties": {
        "viesSessao": { "type": "string" },
        "dxyVariacao": { "type": ["number", "null"] },
        "eventosCriticos": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
