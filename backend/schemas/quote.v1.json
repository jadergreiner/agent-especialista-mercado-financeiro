{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quote v1",
  "type": "object",
  "required": [
    "contractVersion",
    "classeAtivo",
    "instrumento",
    "timestamp"
  ],
  "properties": {
    "contractVersion": { "const": "quote.v1" },
    "classeAtivo": { "type": "string", "enum": ["forex", "cripto", "acoes", "indices", "commodities"] },
    "instrumento": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "par": { "type": "string" },
        "tickerYahoo": { "type": "string" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "precos": {
      "type": "object",
      "properties": {
        "last": { "type": "number" },
        "open": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "close": { "type": "number" },
        "bid": { "type": "number" },
        "ask": { "type": "number" }
      }
    },
    "timeframe": { "type": ["string", "null"], "enum": ["1m", "5m", "15m", "60m", "4h", "1d", null] },
    "fonte": { "type": ["string", "null"] }
  }
}
