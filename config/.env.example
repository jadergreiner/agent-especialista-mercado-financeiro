# Exemplo de variáveis de ambiente (copie para config/.env e ajuste valores)

# Ambiente
AMBIENTE=producao            # producao | homolog | dev
TIMEZONE=UTC
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# Alpaca (paper/live)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Interactive Brokers (Gateway/TWS)
IB_HOST=127.0.0.1
IB_PORT=7497                  # 7497 (paper), 7496 (live)
IB_CLIENT_ID=1

# Risco Global (exemplos)
RISCO_MAXIMO_DIARIO=0.03      # 3%
DRAWNDOWN_MAXIMO=0.15         # 15%

# Web (opcional)
WEB_HOST=127.0.0.1
WEB_PORT=5001
