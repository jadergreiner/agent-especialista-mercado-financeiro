# CONFIGURAÇÃO DE AMBIENTE - Agent Especialista Mercado Financeiro
# COPIE ESTE ARQUIVO PARA .env E CONFIGURE SUAS CHAVES

# =============================================================================
# AMBIENTE DE OPERAÇÃO (CRÍTICO!)
# =============================================================================
# demo      = Ambiente de desenvolvimento/teste (dados históricos, simulação)
# producao  = Ambiente de produção (dados reais, ordens reais!)
# homologacao = Ambiente de testes com dados reais mas ordens paper

AMBIENTE=demo

# =============================================================================
# CORRETORAS (APENAS PARA PRODUÇÃO/HOMOLOGAÇÃO)
# =============================================================================

# Alpaca Markets - Paper Trading (para testes)
ALPACA_API_KEY=SEU_ALPACA_PAPER_KEY
ALPACA_API_SECRET=SEU_ALPACA_PAPER_SECRET
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpaca Markets - Live Trading (APENAS PARA PRODUÇÃO!)
# ALPACA_API_KEY=SUA_CHAVE_REAL_PRODUCAO
# ALPACA_API_SECRET=SUA_CHAVE_SECRETA_REAL_PRODUCAO
# ALPACA_BASE_URL=https://api.alpaca.markets

# Interactive Brokers (se usado)
IB_HOST=127.0.0.1
IB_PORT=7497                  # 7497 (paper), 7496 (live)
IB_CLIENT_ID=1

# =============================================================================
# LIMITES DE RISCO (IMPORTANTE!)
# =============================================================================
# Em produção, sempre use valores conservadores
RISCO_MAXIMO_DIARIO=0.02      # 2% máximo por dia em produção
DRAWNDOWN_MAXIMO=0.10         # 10% drawdown máximo
CONCENTRACAO_MAXIMA=0.20      # 20% concentração máxima por ativo

# =============================================================================
# CONFIGURAÇÕES GERAIS
# =============================================================================
TIMEZONE=UTC
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# Web (opcional)
WEB_HOST=127.0.0.1
WEB_PORT=5001

# =============================================================================
# INSTRUÇÕES DE CONFIGURAÇÃO
# =============================================================================
#
# PARA DESENVOLVIMENTO/TESTES:
#   AMBIENTE=demo
#   -> Usa dados históricos
#   -> Simula ordens (não executa reais)
#   -> Limites de risco ativos
#
# PARA PRODUÇÃO:
#   AMBIENTE=producao
#   ALPACA_API_KEY=SUA_CHAVE_REAL
#   ALPACA_API_SECRET=SUA_CHAVE_SECRETA_REAL
#   -> Usa dados tempo real
#   -> Executa ordens reais!
#   -> Limites de risco rigorosos
#
# ⚠️  NUNCA commite chaves reais no repositório!
# ⚠️  Sempre teste em 'homologacao' antes de ir para produção!

# Web (opcional)
WEB_HOST=127.0.0.1
WEB_PORT=5001

# =============================================================================
# ANÁLISE PROMPT INTERATIVO (MVP)
# =============================================================================
# OpenAI API para análise com LLM
OPENAI_API_KEY=

# Configurações de análise
ANALISE_MODO_PADRAO=analista              # analista | trader_rapido
ANALISE_TIMEFRAME_PADRAO=1D               # 5M | 15M | 1H | 4H | 1D
ANALISE_CACHE_TTL_SEGUNDOS=300            # Cache de 5 minutos (preços/notícias)
ANALISE_MODELO_LLM=gpt-4o-mini            # Modelo OpenAI padrão

# Diretórios de saída
ANALISE_DIR_SAIDAS=backend/data/analises  # Onde salvar JSONs de análises
ANALISE_DIR_LOGS=logs                     # Diretório de logs
